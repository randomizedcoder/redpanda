-#!/usr/bin/env bash
+#!/bin/sh
+# POSIX-compatible bash discovery for Nix sandbox.
+# $BAZEL_SH is set by the Nix build to the real bash path.
+if [ -z "${_RFC_BASH_FOUND:-}" ]; then
+  for _b in "${BAZEL_SH:-}" /bin/bash /usr/bin/bash; do [ -x "$_b" ] && _RFC_BASH_FOUND=1 exec "$_b" "$0" "$@"; done
+  echo "ERROR: bash not found. Set BAZEL_SH." >&2; exit 1
+fi

